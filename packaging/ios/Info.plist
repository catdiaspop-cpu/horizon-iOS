<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The bundle packaging/ios/build_ipa.sh assembles. `__VERSION__` is the release's version. -->
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>Horizon</string>
    <key>CFBundleIdentifier</key>
    <string>dev.horizonlab.horizon</string>
    <key>CFBundleName</key>
    <string>Horizon</string>
    <key>CFBundleDisplayName</key>
    <string>Horizon</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>15.0</string>
    <!-- wgpu takes Metal here, so a device without it has no renderer at all. -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>metal</string>
    </array>

    <!-- A game fills the screen in landscape: no status bar, no rotation animation. -->
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UIStatusBarHidden</key>
    <true/>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Downloads: Mojang's files and server lists are HTTPS, but players' own URLs, custom
         server lists and resource-pack links are whatever the server says, HTTP included. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!-- LAN worlds and servers on the same network (iOS 14 asks the player for this; without the
         string the prompt never appears and the multicast finds nothing). -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Horizon finds Minecraft servers on your local network and lets them find your world.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_minecraft._tcp</string>
    </array>

    <!-- The game folder (Documents) shows in the Files app: saves, resource packs, mods. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
</dict>
</plist>
